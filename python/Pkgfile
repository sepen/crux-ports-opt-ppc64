# Description: Python interpreter, version 2.7
# URL: https://www.python.org
# Maintainer: Juergen Daubert, jue at crux dot nu
# Arch Maintainer: Jose Beneyto, sepen at crux-arm dot nu
# Depends on: db gdbm openssl bzip2 zlib sqlite3 libffi

name=python
version=2.7.18
release=1
source=(http://www.python.org/ftp/$name/$version/Python-$version.tar.xz
        https://dev.gentoo.org/~mgorny/dist/python/python-gentoo-patches-${version}_p16.tar.xz)

build () {
    cd Python-$version

    # CVE-2019-20907
    patch -p1 -i $SRC/python-gentoo-patches-${version}_p16/0001-bpo-39017-Avoid-infinite-loop-in-the-tarfile-module-.patch
    # CVE-2020-8492
    patch -p1 -i $SRC/python-gentoo-patches-${version}_p16/0002-bpo-39503-CVE-2020-8492-Fix-AbstractBasicAuthHandler.patch
    # CVE-2020-26116
    patch -p1 -i $SRC/python-gentoo-patches-${version}_p16/0003-bpo-39603-Prevent-header-injection-in-http-methods-G.patch
    # CVE-2020-27619
    patch -p1 -i $SRC/python-gentoo-patches-${version}_p16/0005-bpo-41944-No-longer-call-eval-on-content-received-vi.patch
    # CVE-2021-3177
    patch -p1 -i $SRC/python-gentoo-patches-${version}_p16/0007-3.6-closes-bpo-42938-Replace-snprintf-with-Python-un.patch
    # CVE-2021-23336
    patch -p1 -i $SRC/python-gentoo-patches-${version}_p16/0008-3.6-bpo-42967-only-use-as-a-query-string-separator-G.patch

    # remove 2to3, we use the one from python3
    rm -r Lib/lib2to3

    # remove tests
    rm -r Lib/{bsddb,ctypes,email,lib-tk,sqlite3,unittest}/test
    rm -r Lib/{{distutils,json}/tests,idlelib/idle_test,test}

    ./configure \
        --prefix=/usr \
        --with-system-ffi \
        --enable-shared \
        --with-threads \
        --enable-ipv6

    make 
    make -j1 DESTDIR=$PKG install

    rm $PKG/usr/bin/python $PKG/usr/bin/python-config $PKG/usr/bin/smtpd.py
    ln -s /usr/lib/libpython2.7.so $PKG/usr/lib/python2.7/config/libpython2.7.so
    rm $PKG/usr/bin/2to3
    rm $PKG/usr/lib/python2.7/{distutils,site-packages}/README
    rm $PKG/usr/lib/python2.7/idlelib/{ChangeLog,{NEWS,README,TODO}.txt}
    rm $PKG/usr/lib/python2.7/ctypes/macholib/README.ctypes
}
